# Supabase — from the project's API settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses every row-level security policy, so it must never
# carry the NEXT_PUBLIC_ prefix and must never be imported into a component
# that runs in the browser.
SUPABASE_SECRET_KEY=

# The college's email domain. Placeholder for now — see docs/dev-accounts.md.
# Enforced again in Postgres; the browser check is a courtesy, not the lock.
NEXT_PUBLIC_COLLEGE_EMAIL_DOMAIN=nest.edu
