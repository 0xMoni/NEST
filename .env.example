# For the scripts in scripts/ only (seeding and importing accounts). Copy to
# .env.local and fill in from Supabase → Project settings → API Keys.
# The web pages do not read this file: they use web/config.js.
SUPABASE_URL=https://your-project.supabase.co

# Bypasses every row-level security policy. Never put it anywhere under web/.
SUPABASE_SECRET_KEY=sb_secret_placeholder
