# dependencies
/node_modules

# local secrets: Supabase keys for the scripts, and for the web pages
.env*
!.env.example
/web/config.js

# Real student data — never commit. The repo is public, and the college's
# lists carry names, email addresses and phone numbers for 500+ people.
# Keep source spreadsheets outside the repo, or inside private-data/.
*.xlsx
*.xls
*.csv
private-data/

# Python bytecode from scripts/ and backend/
__pycache__/
*.pyc

# misc
.DS_Store
*.pem
npm-debug.log*
